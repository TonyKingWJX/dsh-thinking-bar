# 依赖与构建产物之外的东西都不入仓
node_modules/
.work/
.scratch/
.tmp/
.dsh-scratch.txt
b6-dump.txt

# 原始出图素材入仓（可追溯，重出 webp 有源可查）；成品 webp 见 preview/assets
# 只有设计软件的工程文件留在外面
*.psd
*.ai

# 截图脚本产物
*.tmp

# npm pack output
*.tgz

# 本地 npm 缓存（默认缓存目录被沙箱拦时改指到工作区内）
.npm-cache/

# 本地 npm 凭据（发布用 token，绝不入仓）
.npmrc
.npmtoken

# 测试脚本（本地跑，不入仓）
test/

# 参考实现（下载来对照的外部仓库）
.ref/

# 排查过程留下的临时截图
spin-*.png

# 本机 profile 配置备份（package.json / pnpm-lock.yaml 改动前快照，不入仓）
.profile-backup/

