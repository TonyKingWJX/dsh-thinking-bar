{
  "name": "dsh-thinking-bar",
  "version": "1.0.0",
  "private": true,
  "description": "Switchable model/reasoning UI for the DSH composer; reasoning levels come from the system model catalog.",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "icon": "./icon-v2.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon-v2.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-v2.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
